# --- Required ---
DATABASE_URL=mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/your-database-name?appName=Cluster0
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Site identity ---
# Shown in admin titles and OG tags. Defaults to "Boxlio".
SITE_NAME=

# --- Media storage (optional) ---
# S3 storage activates only when S3_BUCKET and S3_ACCESS_KEY_ID are both set;
# otherwise media is stored locally, which is fine for development.
S3_API=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN origin for the bucket, no trailing slash
# (e.g. https://pub-xxxx.r2.dev). Leave blank to serve media through Payload.
S3_PUBLIC_URL=

# --- Email (optional) ---
# The Resend adapter activates only when RESEND_API_KEY and EMAIL_FROM_ADDRESS
# are both set.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
